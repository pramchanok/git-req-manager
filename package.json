{
  "name": "gitlab-req-manager",
  "version": "1.7.2",
  "description": "Desktop app to track GitLab Merge Requests for review",
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/pramchanok/git-req-manager.git"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "publish:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish always",
    "publish:mac": "npm run build && electron-builder --mac dmg zip --publish always",
    "publish:linux": "npm run build && electron-builder --linux AppImage deb --publish always",
    "publish:all": "npm run build && electron-builder --mac dmg zip --publish always && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --arch x64 --publish always && electron-builder --linux AppImage deb --publish always",
    "start": "electron ."
  },
  "build": {
    "appId": "com.gitlab-req-manager.app",
    "productName": "GitLab MR Manager",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "dist/preload.js",
      "assets/**/*",
      "CHANGELOG.md",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "publish": {
      "provider": "github",
      "owner": "pramchanok",
      "repo": "git-req-manager",
      "releaseType": "draft"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "keywords": [],
  "author": {
    "name": "Pramchanok",
    "email": "pramchanok@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "26.15.3",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.5",
    "parse-diff": "^0.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3",
    "which": "^7.0.0"
  }
}
